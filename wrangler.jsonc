{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "othello-shogi",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "ROOM_CREATE_BURST",
      "namespace_id": "731904115",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "API_REQUEST_BURST",
      "namespace_id": "731904116",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "ROOM_ACTION_BURST",
      "namespace_id": "731904117",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "othello-shogi-db",
      "database_id": "c09ec12d-aec3-4118-b3cb-de717980a157",
      "migrations_dir": "drizzle"
    }
  ]
}
